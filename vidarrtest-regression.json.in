[
    {
        "id": "TEST_MMinden_FASTQ_INPUT",
        "description": "runs the nanoporeMapping workflow, with nanopore fastq as input",
        "arguments": {
	"nanoporeMapping.samplefile": {
         "contents": {
            "configuration": "/.mounts/labs/gsi/testdata/nanoporeMapping/test_inputs/MMinden_Test.fastq",
            "externalIds": [
                {
                    "id": "TEST",
                    "provider": "TEST"
                }
            ]
        },
        "type": "EXTERNAL"
      },
            "nanoporeMapping.sample": "MMinden_Test",
            "nanoporeMapping.tumor": "MMinden_Test",
            "nanoporeMapping.normal": "MMinden_Test",
            "nanoporeMapping.generateConfig.jobMemory": null,
            "nanoporeMapping.generateConfig.timeout":null, 
            "nanoporeMapping.mapping.modules": "conda/4.11.0",
            "nanoporeMapping.mapping.timeout": null,
            "nanoporeMapping.mapping.jobMemory": null  
        },
        "engineArguments": {
            "write_to_cache": false,
            "read_from_cache": false
          },
        "metadata": {
            "nanoporeMapping.bAlleleFrequency": {
                "contents": [
                    {
                        "outputDirectory": "@SCRATCH@/@DATE@_Workflow_nanoporeMapping_TEST_MMinden_FASTQ_INPUT_@JENKINSID@"
                    }
                ],
                "type": "ALL"
            }
        },
        "validators": [
            {
                "metrics_calculate": "@CHECKOUT@/tests/calculate.sh",
                "metrics_compare": "@CHECKOUT@/tests/compare.sh",
                "output_metrics": "/.mounts/labs/gsi/testdata/nanoporeMapping/output_metrics/workflow_test_01.metrics",
                "type": "script"
            }
        ]
    }
]
